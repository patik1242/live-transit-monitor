{
  "datasets": [
    {
      "name": "32f12051",
      "displayName": "gold_delay_distribution",
      "config": {
        "version": "1.1",
        "source": "dbr_dev.live_transit_monitor.gold_delay_distribution",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "b1996200",
      "displayName": "top10_delay_routes_now",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    routeShortName,\r\n    ROUND(AVG(delay_min), 2) AS avg_delay_min,\r\n    COUNT(DISTINCT vehicleId) AS active_vehicles\r\nFROM dbr_dev.live_transit_monitor.gold_fleet_current\r\nGROUP BY routeShortName\r\nORDER BY avg_delay_min DESC\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "1fdf26b1",
      "displayName": "top10_now_slowest_routes",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    routeShortName,\r\n    ROUND(AVG(speed), 2) AS avg_speed,\r\n    COUNT(DISTINCT vehicleId) AS active_vehicles\r\nFROM dbr_dev.live_transit_monitor.gold_fleet_current\r\nWHERE is_moving = true\r\nGROUP BY routeShortName\r\nORDER BY avg_speed ASC\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "c2f9d88d",
      "displayName": "gold_live_kpi",
      "config": {
        "version": "1.1",
        "source": "dbr_dev.live_transit_monitor.gold_live_kpi",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "9dec4948",
      "displayName": "top10headsigns",
      "config": {
        "version": "1.1",
        "source": "SELECT \r\n    headsign, \r\n    SUM(active_vehicles) AS active_vehicles\r\nFROM dbr_dev.live_transit_monitor.gold_destination_summary\r\nGROUP BY headsign\r\nORDER BY active_vehicles DESC\r\nlimit 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "b0e12cb1",
      "displayName": "top10_delayed_routes",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    routeShortName,\r\n    transportationType,\r\n    active_vehicles,\r\n    delayed_vehicles,\r\n    ROUND(delayed_vehicles * 100.0 / active_vehicles, 1) AS pct_delayed,\r\n    avg_delay_min,\r\n    max_delay_min,\r\n    ROUND((delayed_vehicles * 100.0 / active_vehicles) * avg_delay_min, 1) AS problem_score\r\nFROM dbr_dev.live_transit_monitor.gold_route_summary\r\nWHERE active_vehicles >= 5\r\nORDER BY problem_score DESC\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "7d65e191",
      "displayName": "most_delayed",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    delay_min AS max_delay_min,\r\n    routeShortName\r\nFROM dbr_dev.live_transit_monitor.gold_fleet_current\r\nWHERE delay_min IS NOT NULL\r\nORDER BY delay_min DESC\r\nLIMIT 1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "8532b8ce",
      "displayName": "top10_delayed_vehicles",
      "config": {
        "version": "1.1",
        "source": "SELECT vehicleCode, routeShortName, headsign, delay_min, speed, event_time\r\nFROM dbr_dev.live_transit_monitor.gold_fleet_current\r\nWHERE delay_min IS NOT NULL\r\nORDER BY delay_min DESC\r\nLIMIT 10",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
